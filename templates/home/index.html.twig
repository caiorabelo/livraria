{% extends 'base.html.twig' %}

{% block title %}Início — Livraria{% endblock %}

{% block body %}
    <section class="mb-4">
        <h1 class="h3 mb-2">Cadastro de livros</h1>
        <p class="lead mb-0">
            Gerencie o acervo, seus autores e assuntos.
        </p>
    </section>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <a class="card dashboard-card h-100 text-decoration-none" href="{{ path('app_livro_index') }}">
                <div class="card-body">
                    <p class="text-muted mb-1">Livros</p>
                    <p class="display-6 fw-semibold mb-2">{{ quantidadeLivros }}</p>
                    <span class="link-primary">Acessar cadastro</span>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a class="card dashboard-card h-100 text-decoration-none" href="{{ path('app_autor_index') }}">
                <div class="card-body">
                    <p class="text-muted mb-1">Autores</p>
                    <p class="display-6 fw-semibold mb-2">{{ quantidadeAutores }}</p>
                    <span class="link-primary">Acessar cadastro</span>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a class="card dashboard-card h-100 text-decoration-none" href="{{ path('app_assunto_index') }}">
                <div class="card-body">
                    <p class="text-muted mb-1">Assuntos</p>
                    <p class="display-6 fw-semibold mb-2">{{ quantidadeAssuntos }}</p>
                    <span class="link-primary">Acessar cadastro</span>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a class="card dashboard-card h-100 text-decoration-none" href="{{ path('app_relatorio_index') }}">
                <div class="card-body">
                    <p class="text-muted mb-1">Relatório</p>
                    <p class="h4 fw-semibold my-3">HTML e PDF</p>
                    <span class="link-primary">Visualizar por autor</span>
                </div>
            </a>
        </div>
    </div>
{% endblock %}
