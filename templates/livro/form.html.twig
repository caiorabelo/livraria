{% extends 'base.html.twig' %}

{% block title %}{{ titulo }} — Livraria{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ titulo }}</h1>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-12 col-md-6">
                {{ form_row(form.titulo) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.editora) }}
            </div>
            <div class="col-12 col-sm-4">
                {{ form_row(form.edicao) }}
            </div>
            <div class="col-12 col-sm-4">
                {{ form_row(form.anoPublicacao) }}
            </div>
            <div class="col-12 col-sm-4">
                {{ form_row(form.valor) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.autores) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.assuntos) }}
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-3">
            <button class="btn btn-primary" type="submit">Salvar</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_livro_index') }}">Cancelar</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
