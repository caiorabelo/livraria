{% extends 'base.html.twig' %}

{% block title %}Relatório por autor — Livraria{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Relatório de livros por autor</h1>
            <p class="text-muted mb-0">Dados consultados na view <code>vw_relatorio_livros</code>.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('app_relatorio_pdf') }}">Baixar PDF</a>
    </div>

    {% if autores is empty %}
        <div class="alert alert-info mb-0">Não há livros com autores vinculados para exibir.</div>
    {% else %}
        {% for grupo in autores %}
            <section class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">{{ grupo.autor }}</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Livro</th>
                                <th scope="col">Editora</th>
                                <th scope="col">Edição</th>
                                <th scope="col">Ano</th>
                                <th scope="col">Assuntos</th>
                                <th scope="col" class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for livro in grupo.livros %}
                                <tr>
                                    <td>{{ livro.titulo }}</td>
                                    <td>{{ livro.editora }}</td>
                                    <td>{{ livro.edicao }}ª</td>
                                    <td>{{ livro.anoPublicacao }}</td>
                                    <td>{{ livro.assuntos ?: '—' }}</td>
                                    <td class="text-end text-nowrap">
                                        R$ {{ livro.valor|number_format(2, ',', '.') }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endfor %}
    {% endif %}
{% endblock %}
